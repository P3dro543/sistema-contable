<IfModule mod_rewrite.c>
    Options -Multiviews
    RewriteEngine On
    # Cambiamos /sitios2/ por el nombre real de tu carpeta
    RewriteBase /sistema-contable
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>