Options -Indexes

RewriteEngine On
RewriteBase /sistema-contable/

# Redirección de URLs amigables
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?ruta=$1 [QSA,L]

# Bloqueo de acceso directo a carpetas sensibles (Simplificado)
RedirectMatch 403 ^/(config|models|controllers)/